# Local dev instance settings (#36, #38).
#
# Copy this file to scripts/dev/.env - it is gitignored - and adjust what you
# need. `mise run dev-up` sources it before it starts the container, so
# HA_VERSION picks the image tag.
#
# A concrete tag, not `stable`. `stable` is a moving tag: every `mise run dev-up`
# recreates the container and can silently install a Home Assistant nobody chose,
# so an upgrade reads as "nothing changed" and a breakage appears without a
# commit that caused it. Pinned here is 2026.10.4, the release the local dev
# container runs; the running version is what Home Assistant writes to
# /config/.HA_VERSION inside the container. Bumping it is the whole upgrade
# procedure: edit the tag, `mise run dev-up`, `mise run dev-smoke` (#38, and
# "Bumping the dev image" in scripts/dev/README.md).
#
# Move this tag and requirements_test.txt together: that file pins
# pytest-homeassistant-custom-component==0.13.316, which pins the Home Assistant
# the tests run against - 2026.2.3 today, so the image is currently ahead of the
# test harness. A bump of one without the other widens that gap, and a green
# `mise run test` then says nothing about the release the dev instance runs.
HA_VERSION=2026.10.4

# Which CKW the instance talks to is one command each way:
#
#   mise run dev-env-mock   the local mock on :8787, no CKW login needed
#   mise run dev-env-prod   the real CKW single sign-on
#
# scripts/dev/switch-env.sh writes and removes the marked block below; use
# those tasks instead of editing the block by hand. `dev-up` passes the
# variables into the container, where the integration reads them from its
# environment; from inside the container the mock is
# http://host.containers.internal:8787. Without the block the production
# endpoints from custom_components/ckw/const.py are used.
# >>> switch-env.sh: mock CKW endpoints >>>
CKW_API_BASE_URL=http://host.containers.internal:8787/api/v1
CKW_AUTHORIZE_URL=http://host.containers.internal:8787/realms/CKW-prod/protocol/openid-connect/auth
CKW_TOKEN_URL=http://host.containers.internal:8787/realms/CKW-prod/protocol/openid-connect/token
# <<< switch-env.sh: mock CKW endpoints <<<
