# Local dev instance settings (#36, #38).
#
# Copy this file to scripts/dev/.env - it is gitignored - and adjust what you
# need. `mise run dev-up` sources it before it starts the container, so
# HA_VERSION picks the image tag. Bumping it is the whole upgrade procedure:
# edit the tag, `mise run dev-up`, then `mise run dev-smoke` (#38).
#
# The CKW_* values point the integration at the mock (scripts/dev/mock/README.md).
# `dev-up` passes them into the container, where the integration reads them from
# its environment; from inside the container the same server is
# http://host.containers.internal:8787. Production values come from
# custom_components/ckw/const.py and stay the defaults when these are unset.
HA_VERSION=stable
CKW_API_BASE_URL=http://host.containers.internal:8787/api/v1
CKW_AUTHORIZE_URL=http://host.containers.internal:8787/realms/CKW-prod/protocol/openid-connect/auth
CKW_TOKEN_URL=http://host.containers.internal:8787/realms/CKW-prod/protocol/openid-connect/token
